rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Canlı projede profilleri ve rolleri yalnız Admin SDK atar.
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    // Var olan koleksiyonların canlı yetki davranışı korunur.
    match /repairs/{document=**} {
      allow read, write: if isAdmin();
    }
    match /repairPhotos/{document=**} {
      allow read, write: if isAdmin();
    }
    match /qrAccessLog/{document=**} {
      allow read, write: if isAdmin();
    }
    match /appLogs/{document=**} {
      allow read, write: if isAdmin();
    }
    match /stockBatches/{document=**} {
      allow read, write: if isAdmin();
    }

    // Yeni istemci şeması henüz üretim akışına geçirilmedi.
    match /services/{serviceId} {
      allow read, write: if isAdmin();
    }
  }
}
